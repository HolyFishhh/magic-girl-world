{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-girl-world.invalid/schema/mwg-card-effects-v1.schema.json",
  "title": "Magic Girl World Compact Card Effects v1",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["effects"] },
    { "required": ["trigger"] }
  ],
  "properties": {
    "trigger": { "$ref": "#/$defs/triggerInput" },
    "creates": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/cardTemplate" }
    },
    "effects": {
      "$ref": "#/$defs/effectList"
    }
  },
  "$defs": {
    "formula": {
      "oneOf": [
        { "type": "number", "multipleOf": 0.1 },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      ]
    },
    "target": {
      "enum": ["self", "opponent"]
    },
    "enemyTargetSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "enum": ["active", "all", "lowest_hp", "highest_hp"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "id"],
          "properties": { "mode": { "const": "by_id" }, "id": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "random" },
            "allow_repeat": { "type": "boolean" },
            "retarget": { "enum": ["locked", "each_hit"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "count"],
          "properties": {
            "mode": { "const": "random_n" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "allow_repeat": { "type": "boolean" },
            "retarget": { "enum": ["locked", "each_hit"] }
          }
        }
      ]
    },
    "cardZone": {
      "enum": ["hand", "draw", "discard", "exhaust", "all"]
    },
    "cardPick": {
      "enum": ["random", "choose", "left", "right", "top", "bottom", "all"]
    },
    "cardTypeFilter": {
      "anyOf": [
        { "enum": ["Attack", "Skill", "Power", "Event", "Curse"] },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Attack", "Skill", "Power", "Event", "Curse"] } }
      ]
    },
    "cardRarityFilter": {
      "anyOf": [
        { "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Corrupt"] },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Corrupt"] } }
      ]
    },
    "cardTagFilter": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "cardOriginFilter": {
      "enum": ["deck", "generated", "copied", "transformed"]
    },
    "trigger": {
      "enum": [
        "ability_gain",
        "turn_start",
        "turn_end",
        "card_played",
        "attack_played",
        "skill_played",
        "power_played",
        "on_discard",
        "on_exhaust",
        "on_draw",
        "on_shuffle",
        "take_damage",
        "take_heal",
        "deal_damage",
        "deal_heal",
        "lust_increase",
        "lust_decrease",
        "deal_lust_increase",
        "deal_lust_decrease",
        "gain_buff",
        "gain_debuff",
        "lose_buff",
        "lose_debuff",
        "enemy_gain_buff",
        "enemy_gain_debuff",
        "enemy_lose_buff",
        "enemy_lose_debuff",
        "gain_block",
        "lose_block"
      ]
    },
    "triggerInput": {
      "oneOf": [
        { "$ref": "#/$defs/trigger" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["on", "effects"],
          "properties": {
            "on": { "$ref": "#/$defs/trigger" },
            "effects": { "$ref": "#/$defs/effectList" }
          }
        }
      ]
    },
    "amountEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damage"],
      "properties": {
        "damage": { "$ref": "#/$defs/formula" },
        "hits": { "type": "integer", "minimum": 1, "maximum": 20 },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "healEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heal"],
      "properties": {
        "heal": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "blockEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block"],
      "properties": {
        "block": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "energyEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy"],
      "properties": {
        "energy": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "lustEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lust"],
      "properties": {
        "lust": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "setEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set_hp": { "$ref": "#/$defs/formula" },
        "set_lust": { "$ref": "#/$defs/formula" },
        "set_energy": { "$ref": "#/$defs/formula" },
        "set_block": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      },
      "oneOf": [
        { "required": ["set_hp"] },
        { "required": ["set_lust"] },
        { "required": ["set_energy"] },
        { "required": ["set_block"] }
      ]
    },
    "narrateEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrate"],
      "properties": {
        "narrate": { "type": "string", "minLength": 1 },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "applyStatusEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apply_status"],
      "properties": {
        "apply_status": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "stacks": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "removeStatusEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remove_status"],
      "properties": {
        "remove_status": {
          "anyOf": [
            { "enum": ["all", "buffs", "debuffs"] },
            { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          ]
        },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "drawEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draw"],
      "properties": {
        "draw": { "$ref": "#/$defs/formula" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "scryEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scry"],
      "properties": {
        "scry": { "$ref": "#/$defs/formula" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "seekEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seek"],
      "properties": {
        "seek": { "$ref": "#/$defs/formula" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "moveCardEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["discard"],
          "properties": {
            "discard": { "anyOf": [{ "$ref": "#/$defs/formula" }, { "const": "all" }] },
            "from": { "$ref": "#/$defs/cardZone" },
            "pick": { "$ref": "#/$defs/cardPick" },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" },
            "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 },
            "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" },
            "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 },
            "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" },
            "upgraded": { "type": "boolean" },
            "on": { "$ref": "#/$defs/trigger" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exhaust"],
          "properties": {
            "exhaust": { "anyOf": [{ "$ref": "#/$defs/formula" }, { "const": "all" }] },
            "from": { "$ref": "#/$defs/cardZone" },
            "pick": { "$ref": "#/$defs/cardPick" },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" },
            "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 },
            "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" },
            "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 },
            "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" },
            "upgraded": { "type": "boolean" },
            "on": { "$ref": "#/$defs/trigger" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        }
      ]
    },
    "recoverEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recover"],
      "properties": {
        "recover": { "anyOf": [{ "$ref": "#/$defs/formula" }, { "const": "all" }] },
        "from": { "enum": ["discard", "exhaust"] },
        "pick": { "enum": ["random", "choose", "all"] },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "reduceCostEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduce_cost"],
      "properties": {
        "reduce_cost": { "$ref": "#/$defs/formula" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "from": { "$ref": "#/$defs/cardZone" },
        "pick": { "$ref": "#/$defs/cardPick" },
        "card_type": { "$ref": "#/$defs/cardTypeFilter" },
        "rarity": { "$ref": "#/$defs/cardRarityFilter" },
        "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
        "min_cost": { "type": "number", "minimum": 0 },
        "max_cost": { "type": "number", "minimum": 0 },
        "tag": { "$ref": "#/$defs/cardTagFilter" },
        "template_id": { "type": "string", "minLength": 1 },
        "run_instance_id": { "type": "string", "minLength": 1 },
        "combat_instance_id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/cardOriginFilter" },
        "upgraded": { "type": "boolean" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "modifyCardEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modify_card"],
      "properties": {
        "modify_card": { "enum": ["damage", "block", "lust", "stacks"] },
        "add": { "$ref": "#/$defs/formula" },
        "subtract": { "$ref": "#/$defs/formula" },
        "multiply": { "$ref": "#/$defs/formula" },
        "divide": { "$ref": "#/$defs/formula" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "from": { "$ref": "#/$defs/cardZone" },
        "pick": { "$ref": "#/$defs/cardPick" },
        "card_type": { "$ref": "#/$defs/cardTypeFilter" },
        "rarity": { "$ref": "#/$defs/cardRarityFilter" },
        "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
        "min_cost": { "type": "number", "minimum": 0 },
        "max_cost": { "type": "number", "minimum": 0 },
        "tag": { "$ref": "#/$defs/cardTagFilter" },
        "template_id": { "type": "string", "minLength": 1 },
        "run_instance_id": { "type": "string", "minLength": 1 },
        "combat_instance_id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/cardOriginFilter" },
        "upgraded": { "type": "boolean" },
        "when": { "$ref": "#/$defs/formulaString" }
      },
      "oneOf": [
        { "required": ["add"] },
        { "required": ["subtract"] },
        { "required": ["multiply"] },
        { "required": ["divide"] }
      ]
    },
    "selectCardEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["copy"],
          "properties": {
            "copy": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "const": "all" }] },
            "from": { "$ref": "#/$defs/cardZone" },
            "pick": { "$ref": "#/$defs/cardPick" },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" },
            "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 },
            "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" },
            "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 },
            "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" },
            "upgraded": { "type": "boolean" },
            "on": { "$ref": "#/$defs/trigger" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["double"],
          "properties": {
            "double": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "const": "all" }] },
            "from": { "$ref": "#/$defs/cardZone" },
            "pick": { "$ref": "#/$defs/cardPick" },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" },
            "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 },
            "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" },
            "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 },
            "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" },
            "upgraded": { "type": "boolean" },
            "on": { "$ref": "#/$defs/trigger" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        }
      ]
    },
    "addCardEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add_card"],
      "properties": {
        "add_card": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "to": { "enum": ["hand", "deck"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "cardPatchEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_card"],
      "properties": {
        "patch_card": { "enum": ["damage", "block", "lust", "stacks", "cost", "dynamic_cost", "x_value", "replay", "retain", "exhaust", "ethereal", "innate"] },
        "add": { "$ref": "#/$defs/formula" },
        "subtract": { "$ref": "#/$defs/formula" },
        "multiply": { "$ref": "#/$defs/formula" },
        "divide": { "$ref": "#/$defs/formula" },
        "set": { "$ref": "#/$defs/formula" },
        "min": { "$ref": "#/$defs/formula" },
        "max": { "$ref": "#/$defs/formula" },
        "extra": { "$ref": "#/$defs/formula" },
        "enabled": { "type": "boolean" },
        "scope": { "enum": ["resolution", "turn", "until_played", "combat", "run", "permanent"] },
        "match": { "enum": ["instance", "run_instance", "template", "filter"] },
        "future_copies": { "type": "boolean" },
        "timing": { "enum": ["on_draw", "while_in_hand", "on_play"] },
        "minimum": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "from": { "$ref": "#/$defs/cardZone" },
        "pick": { "$ref": "#/$defs/cardPick" },
        "card_type": { "$ref": "#/$defs/cardTypeFilter" },
        "rarity": { "$ref": "#/$defs/cardRarityFilter" },
        "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
        "min_cost": { "type": "number", "minimum": 0 },
        "max_cost": { "type": "number", "minimum": 0 },
        "tag": { "$ref": "#/$defs/cardTagFilter" },
        "template_id": { "type": "string", "minLength": 1 },
        "run_instance_id": { "type": "string", "minLength": 1 },
        "combat_instance_id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/cardOriginFilter" },
        "upgraded": { "type": "boolean" },
        "on": { "$ref": "#/$defs/trigger" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "modifierEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modify"],
      "properties": {
        "modify": { "enum": ["damage", "damage_taken", "lust", "lust_taken", "heal", "block"] },
        "add": { "$ref": "#/$defs/formula" },
        "subtract": { "$ref": "#/$defs/formula" },
        "multiply": { "$ref": "#/$defs/formula" },
        "divide": { "$ref": "#/$defs/formula" },
        "set": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" }
      },
      "oneOf": [
        { "required": ["add"] },
        { "required": ["subtract"] },
        { "required": ["multiply"] },
        { "required": ["divide"] },
        { "required": ["set"] }
      ]
    },
    "cardPlayRuleEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["card_rule", "limit"],
          "properties": {
            "card_rule": { "const": "free" },
            "limit": { "anyOf": [{ "$ref": "#/$defs/formula" }, { "const": "all" }] },
            "to": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["card_rule", "limit"],
          "properties": {
            "card_rule": { "const": "replay" },
            "limit": { "anyOf": [{ "$ref": "#/$defs/formula" }, { "const": "all" }] },
            "extra": { "$ref": "#/$defs/formula" },
            "to": { "$ref": "#/$defs/target" }
          }
        }
      ]
    },
    "cardTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "anyOf": [
        { "required": ["effects"] },
        { "required": ["trigger"] }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string" },
        "type": { "enum": ["Attack", "Skill", "Power", "Event", "Curse"] },
        "rarity": { "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Corrupt"] },
        "cost": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "energy" }] },
        "description": { "type": "string" },
        "effects": {
          "$ref": "#/$defs/effectList"
        },
        "discard_effects": {
          "$ref": "#/$defs/effectList"
        },
        "trigger": { "$ref": "#/$defs/triggerInput" },
        "retain": { "type": "boolean" },
        "exhaust": { "type": "boolean" },
        "ethereal": { "type": "boolean" }
      }
    },
    "formulaString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "effect": {
      "anyOf": [
        { "$ref": "#/$defs/amountEffect" },
        { "$ref": "#/$defs/healEffect" },
        { "$ref": "#/$defs/blockEffect" },
        { "$ref": "#/$defs/energyEffect" },
        { "$ref": "#/$defs/lustEffect" },
        { "$ref": "#/$defs/setEffect" },
        { "$ref": "#/$defs/narrateEffect" },
        { "$ref": "#/$defs/applyStatusEffect" },
        { "$ref": "#/$defs/removeStatusEffect" },
        { "$ref": "#/$defs/drawEffect" },
        { "$ref": "#/$defs/scryEffect" },
        { "$ref": "#/$defs/seekEffect" },
        { "$ref": "#/$defs/moveCardEffect" },
        { "$ref": "#/$defs/recoverEffect" },
        { "$ref": "#/$defs/reduceCostEffect" },
        { "$ref": "#/$defs/modifyCardEffect" },
        { "$ref": "#/$defs/cardPatchEffect" },
        { "$ref": "#/$defs/selectCardEffect" },
        { "$ref": "#/$defs/addCardEffect" },
        { "$ref": "#/$defs/modifierEffect" },
        { "$ref": "#/$defs/cardPlayRuleEffect" },
        { "$ref": "#/$defs/scheduleEffect" },
        { "$ref": "#/$defs/autoPlayEffect" },
        { "$ref": "#/$defs/cardDestinationEffect" },
        { "$ref": "#/$defs/advancedZoneEffect" },
        { "$ref": "#/$defs/bundleEffect" }
      ]
    },
    "bundleEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damage": { "$ref": "#/$defs/formula" },
        "heal": { "$ref": "#/$defs/formula" },
        "block": { "$ref": "#/$defs/formula" },
        "energy": { "$ref": "#/$defs/formula" },
        "lust": { "$ref": "#/$defs/formula" },
        "apply_status": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "remove_status": {
          "anyOf": [
            { "enum": ["all", "buffs", "debuffs"] },
            { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          ]
        },
        "draw": { "$ref": "#/$defs/formula" },
        "stacks": { "$ref": "#/$defs/formula" },
        "to": { "$ref": "#/$defs/target" },
        "targets": { "$ref": "#/$defs/enemyTargetSelector" },
        "when": { "$ref": "#/$defs/formulaString" },
        "on": { "$ref": "#/$defs/trigger" }
      },
      "minProperties": 2,
      "anyOf": [
        { "required": ["damage"] },
        { "required": ["heal"] },
        { "required": ["block"] },
        { "required": ["energy"] },
        { "required": ["lust"] },
        { "required": ["apply_status"] },
        { "required": ["remove_status"] },
        { "required": ["draw"] }
      ]
    },
    "scheduleEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "effects"],
      "properties": {
        "schedule": { "type": "integer", "minimum": 0, "maximum": 999 },
        "phase": { "enum": ["turn_start", "before_draw", "after_draw", "turn_end"] },
        "priority": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "repeat_every": { "type": "integer", "minimum": 1, "maximum": 999 },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 999 },
        "effects": { "$ref": "#/$defs/effectList" },
        "when": { "$ref": "#/$defs/formulaString" }
      },
      "dependentRequired": {
        "repeat_every": ["repeats"],
        "repeats": ["repeat_every"]
      }
    },
    "autoPlayEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_play"],
      "properties": {
        "auto_play": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 100 },
            { "const": "all" }
          ]
        },
        "from": { "$ref": "#/$defs/cardZone" },
        "pick": { "$ref": "#/$defs/cardPick" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "free": { "type": "boolean" },
        "card_type": { "$ref": "#/$defs/cardTypeFilter" },
        "rarity": { "$ref": "#/$defs/cardRarityFilter" },
        "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
        "min_cost": { "type": "number", "minimum": 0 },
        "max_cost": { "type": "number", "minimum": 0 },
        "tag": { "$ref": "#/$defs/cardTagFilter" },
        "template_id": { "type": "string", "minLength": 1 },
        "run_instance_id": { "type": "string", "minLength": 1 },
        "combat_instance_id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/cardOriginFilter" },
        "upgraded": { "type": "boolean" },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "cardDestinationEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_destination"],
      "properties": {
        "card_destination": { "enum": ["discard", "exhaust", "draw_top", "draw_bottom", "hand", "remove"] },
        "when": { "$ref": "#/$defs/formulaString" }
      }
    },
    "advancedZoneEffect": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["move_card", "destination"],
          "properties": {
            "move_card": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "const": "all" }] },
            "from": { "$ref": "#/$defs/cardZone" }, "pick": { "$ref": "#/$defs/cardPick" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "destination": { "enum": ["hand", "draw", "discard", "exhaust"] },
            "position": { "enum": ["top", "bottom"] },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" }, "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 }, "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" }, "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 }, "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" }, "upgraded": { "type": "boolean" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["remove_card"],
          "properties": {
            "remove_card": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "const": "all" }] },
            "from": { "$ref": "#/$defs/cardZone" }, "pick": { "$ref": "#/$defs/cardPick" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" }, "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 }, "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" }, "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 }, "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" }, "upgraded": { "type": "boolean" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["transform_card"],
          "properties": {
            "transform_card": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "from": { "$ref": "#/$defs/cardZone" }, "pick": { "$ref": "#/$defs/cardPick" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "card_type": { "$ref": "#/$defs/cardTypeFilter" }, "rarity": { "$ref": "#/$defs/cardRarityFilter" },
            "cost": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "energy" }] },
            "min_cost": { "type": "number", "minimum": 0 }, "max_cost": { "type": "number", "minimum": 0 },
            "tag": { "$ref": "#/$defs/cardTagFilter" }, "template_id": { "type": "string", "minLength": 1 },
            "run_instance_id": { "type": "string", "minLength": 1 }, "combat_instance_id": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/cardOriginFilter" }, "upgraded": { "type": "boolean" },
            "when": { "$ref": "#/$defs/formulaString" }
          }
        }
      ]
    },
    "effectList": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/effect" }
        },
        { "$ref": "#/$defs/effect" },
        { "$ref": "#/$defs/bundleEffect" }
      ]
    }
  }
}
